@page "/posts"
@attribute [Authorize]
@using website.Services
@using website.Data
@inject FirebaseService DbService
@inject IJSRuntime JSRuntime

<h3>Manage Posts</h3>
<div class="mb-3">
    <button class="btn btn-outline-primary btn-sm" @onclick="RefreshPosts" disabled="@isLoading">
        Refresh List
    </button>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>User</th>
                <th>Category</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in posts)
            {
                <tr>
                    <td>
                        @if(!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" width="50" height="50" style="object-fit:cover; border-radius: 8px;" />
                        }
                    </td>
                    <td>@post.Title</td>
                    <td>@post.Username</td>
                    <td>@post.Category</td>
                    <td>
                        <span class="badge @GetStatusBadge(post.Status)">@post.Status</span>
                    </td>
                    <td>@post.CreatedAt.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeletePost(post.PostId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DonationPost> posts = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
    }

    private async Task RefreshPosts()
    {
        isLoading = true;
        await LoadPosts(true);
    }

    private async Task LoadPosts(bool forceRefresh = false)
    {
        posts = await DbService.GetRecentPostsAsync(50, forceRefresh);
        isLoading = false;
    }

    private async Task DeletePost(string postId)
    {
        if (string.IsNullOrEmpty(postId)) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this post?");
        if (confirm)
        {
            await DbService.DeletePostAsync(postId);
            // No need to force refresh from server, cache is updated locally
            await LoadPosts(false);
        }
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Available" => "bg-success",
            "Reserved" => "bg-warning",
            "Completed" => "bg-secondary",
            _ => "bg-primary"
        };
    }
}
