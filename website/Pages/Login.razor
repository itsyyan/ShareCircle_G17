@page "/login"
@layout LoginLayout
@using website.Authentication
@using website.Services
@using website.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject FirebaseService DbService

<div class="login-card shadow-lg">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">ShareCircle</h2>
        <p class="text-muted">Admin Dashboard</p>
    </div>

    <div class="mb-3">
        <label class="form-label text-secondary">Username</label>
        <input type="text" class="form-control form-control-lg" @bind="username" placeholder="Enter username" />
    </div>
    
    <div class="mb-4">
        <label class="form-label text-secondary">Password</label>
        <input type="password" class="form-control form-control-lg" @bind="password" placeholder="Enter password" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fade show" role="alert">
            <i class="oi oi-warning me-2"></i> @errorMessage
        </div>
    }

    <button class="btn btn-primary btn-lg w-100 fw-bold" @onclick="HandleLogin" disabled="@isLoading" style="background: linear-gradient(to right, rgb(5, 39, 103), #3a0647); border: none;">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Signing In...</span>
        }
        else
        {
            <span>SIGN IN</span>
        }
    </button>
</div>

<style>
    .login-card {
        background-color: white;
        padding: 3rem;
        border-radius: 1rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    
    .form-control-lg {
        font-size: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    .form-control-lg:focus {
        background-color: white;
        box-shadow: 0 0 0 4px rgba(5, 39, 103, 0.1);
        border-color: rgb(5, 39, 103);
    }
</style>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both username and password.";
            return;
        }

        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        bool isAuthenticated = await DbService.AuthenticateAdminAsync(username, password);

        if (isAuthenticated)
        {
            ((SimpleAuthStateProvider)AuthStateProvider).AuthenticateUser(username);
            NavManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Invalid username or password.";
        }
        
        isLoading = false;
    }
}
