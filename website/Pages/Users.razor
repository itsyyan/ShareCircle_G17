@page "/users"
@attribute [Authorize]
@using website.Services
@using website.Data
@inject FirebaseService DbService
@inject IJSRuntime JSRuntime

<h3>Manage Users</h3>
<div class="mb-3">
    <button class="btn btn-outline-primary btn-sm" @onclick="RefreshUsers" disabled="@isLoading">
        Refresh List
    </button>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Avatar</th>
                <th>Username</th>
                <th>Email</th>
                <th>Joined Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>
                        @if(!string.IsNullOrEmpty(user.ProfileImageUrl))
                        {
                            <img src="@user.ProfileImageUrl" width="40" height="40" style="border-radius: 50%;" />
                        }
                        else
                        {
                            <div style="width:40px; height:40px; background-color:#ccc; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                <span>@user.Username?.FirstOrDefault()</span>
                            </div>
                        }
                    </td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.CreatedAt.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(user.UserId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<User> users = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task RefreshUsers()
    {
        isLoading = true;
        await LoadUsers(true);
    }

    private async Task LoadUsers(bool forceRefresh = false)
    {
        users = await DbService.GetRecentUsersAsync(50, forceRefresh);
        isLoading = false;
    }

    private async Task DeleteUser(string userId)
    {
        if (string.IsNullOrEmpty(userId)) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user?");
        if (confirm)
        {
            await DbService.DeleteUserAsync(userId);
            // No need to force refresh from server, cache is updated locally
            await LoadUsers(false);
        }
    }
}
