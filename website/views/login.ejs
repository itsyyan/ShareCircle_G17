<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ShareCircle Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/open-iconic@1.1.1/font/css/open-iconic-bootstrap.min.css" rel="stylesheet">
    <style>
        .login-layout {
            height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: linear-gradient(135deg, rgb(5, 39, 103) 0%, #3a0647 100%);
            margin: 0;
            padding: 0;
        }

        .login-content {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .login-card {
            background-color: white;
            padding: 3rem;
            border-radius: 1rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .form-control-lg {
            font-size: 1rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
        }

        .form-control-lg:focus {
            background-color: white;
            box-shadow: 0 0 0 4px rgba(5, 39, 103, 0.1);
            border-color: rgb(5, 39, 103);
        }

        .btn-gradient {
            background: linear-gradient(to right, rgb(5, 39, 103), #3a0647);
            border: none;
        }

        .btn-gradient:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="login-layout">
        <div class="login-content">
            <div class="login-card shadow-lg">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">ShareCircle</h2>
                    <p class="text-muted">Admin Dashboard</p>
                </div>

                <form method="POST" action="/login" id="loginForm">
                    <div class="mb-3">
                        <label class="form-label text-secondary">Username</label>
                        <input type="text" class="form-control form-control-lg" name="username" placeholder="Enter username" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary">Password</label>
                        <input type="password" class="form-control form-control-lg" name="password" placeholder="Enter password" required>
                    </div>

                    <% if (error) { %>
                    <div class="alert alert-danger fade show" role="alert">
                        <i class="oi oi-warning me-2"></i> <%= error %>
                    </div>
                    <% } %>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold btn-gradient" id="submitBtn">
                        <span class="btn-text">SIGN IN</span>
                        <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.querySelector('.btn-text').textContent = 'Signing In...';
            btn.querySelector('.spinner-border').classList.remove('d-none');
            btn.disabled = true;
        });
    </script>
</body>
</html>
