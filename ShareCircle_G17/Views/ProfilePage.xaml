<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.ProfilePage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="*,Auto">
        <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing" RefreshColor="#5B2EFF" Grid.Row="0">
            <ScrollView>
                <VerticalStackLayout Spacing="18">

                <!-- Header - full width with gradient -->
                <Grid HeightRequest="170" Margin="-0,0,-0,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5B2EFF" Offset="0.0" />
                            <GradientStop Color="#7C5CFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid Padding="20,32,20,20" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Start">
                            <Label
                                Text="Profile"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />
                            <Button
                                Grid.Column="1"
                                Text="Edit"
                                Padding="16,10"
                                BackgroundColor="#6D5BFF"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                CornerRadius="12"
                                TextColor="White"
                                HeightRequest="40"
                                Clicked="OnEditProfileClicked" />
                        </Grid>

                        <HorizontalStackLayout
                            Grid.Row="1"
                            Spacing="16"
                            VerticalOptions="Center"
                            HorizontalOptions="Start">

                            <Frame
                                WidthRequest="88"
                                HeightRequest="88"
                                CornerRadius="44"
                                Padding="0"
                                HasShadow="False"
                                BackgroundColor="#EEF0F4"
                                BorderColor="#E2E8F0">
                                <Grid>
                                    <Image
                                        x:Name="UserAvatarImage"
                                        Aspect="AspectFill"
                                        IsVisible="False" />
                                    <Label
                                        x:Name="UserInitialLabel"
                                        Text="--"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        TextColor="#1F2933"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Frame>

                            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label
                                    x:Name="UserNameLabel"
                                    Text="Loading..."
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#FFFFFF" />
                                <Label
                                    x:Name="UserEmailLabel"
                                    Text="Loading..."
                                    FontSize="13"
                                    TextColor="#E5E7EB" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>

                <!-- Stats -->
                <Grid
                    Padding="20,0,20,0"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="12"
                    VerticalOptions="Start">
                    <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Listings" FontSize="12" TextColor="#6B7280" />
                            <Label
                                x:Name="ListingsCountLabel"
                                Text="0"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#111827" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Completed" FontSize="12" TextColor="#6B7280" />
                            <Label
                                x:Name="CompletedCountLabel"
                                Text="0"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#111827" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Saved" FontSize="12" TextColor="#6B7280" />
                            <Label
                                x:Name="SavedItemsCountLabel"
                                Text="0"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#111827" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Shortcuts -->
                <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                    <Label
                        Text="Shortcuts"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <Label Text="My donations" FontSize="16" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMyDonationsClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <Label Text="My requests" FontSize="16" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMyRequestsClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <Label Text="Saved items" FontSize="16" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSavedItemsClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <Label Text="My addresses" FontSize="16" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMyAddressesClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                    <Label
                        Text="Settings"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <VerticalStackLayout Spacing="16">
                        <!-- Privacy & Security -->
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="Privacy &amp; Security"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Text="Change Password"
                                            FontSize="16"
                                            VerticalOptions="Center"
                                            TextColor="#111827" />
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnChangePasswordClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Text="Privacy Policy"
                                            FontSize="16"
                                            VerticalOptions="Center"
                                            TextColor="#111827" />
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPrivacyPolicyClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Text="Terms of Service"
                                            FontSize="16"
                                            VerticalOptions="Center"
                                            TextColor="#111827" />
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTermsClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Data & Storage -->
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="Data &amp; Storage"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                Text="Clear Cache"
                                                FontSize="16"
                                                TextColor="#111827" />
                                            <Label
                                                Text="Free up storage space"
                                                FontSize="12"
                                                TextColor="#9CA3AF" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnClearCacheClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- About -->
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="About"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Text="About ShareCircle"
                                            FontSize="16"
                                            VerticalOptions="Center"
                                            TextColor="#111827" />
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAboutClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Danger Zone -->
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="Danger Zone"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#E11D48" />

                            <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#FEE2E2">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                Text="Delete Account"
                                                FontSize="16"
                                                TextColor="#E11D48" />
                                            <Label
                                                Text="Permanently delete your account"
                                                FontSize="12"
                                                TextColor="#9CA3AF" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#E11D48" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDeleteAccountClicked" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Logout -->
                <Grid Padding="20,0,20,24">
                    <Button
                        Text="Logout"
                        BackgroundColor="#E11D48"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnLogoutClicked" />
                </Grid>

                <!-- App Version -->
                <VerticalStackLayout Spacing="6" Padding="20,0,20,24" HorizontalOptions="Center">
                    <Label
                        x:Name="VersionLabel"
                        Text="Version 1.0.0"
                        FontSize="13"
                        TextColor="#9CA3AF"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Ac 2025 ShareCircle Team"
                        FontSize="11"
                        TextColor="#D1D5DB"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <!-- Floating bottom navigation -->
        <Grid Grid.Row="1" Padding="16,0,16,16" VerticalOptions="End">
            <Frame
                BackgroundColor="#5B2EFF"
                CornerRadius="24"
                Padding="16,12"
                HasShadow="True">
                <Frame.Shadow>
                    <Shadow Brush="#40000000" Radius="20" Offset="0,-5" Opacity="0.8" />
                </Frame.Shadow>
                <Grid ColumnDefinitions="*,*,Auto,*,*" ColumnSpacing="8" VerticalOptions="Center">
                    <!-- Home -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeNavTapped" NumberOfTapsRequired="1" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image
                            Source="home.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            Aspect="AspectFit" />
                        <Label Text="Home" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Explore -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExploreNavTapped" NumberOfTapsRequired="1" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image
                            Source="https://img.icons8.com/ios/50/ffffff/compass--v1.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            Aspect="AspectFit" />
                        <Label Text="Explore" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Add/Donate button (center) -->
                    <VerticalStackLayout
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Frame
                            HeightRequest="62"
                            WidthRequest="62"
                            CornerRadius="31"
                            BackgroundColor="White"
                            HasShadow="True"
                            Padding="0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDonateNavTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Image
                                    Source="add_2.png"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    Aspect="AspectFit" />
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Notification -->
                    <VerticalStackLayout
                        Grid.Column="3"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationNavTapped" NumberOfTapsRequired="1" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image
                            Source="https://img.icons8.com/ios/50/ffffff/appointment-reminders--v1.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            Aspect="AspectFit" />
                        <Label Text="Notify" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Profile -->
                    <VerticalStackLayout
                        Grid.Column="4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileNavTapped" NumberOfTapsRequired="1" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image
                            Source="face.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            Aspect="AspectFit" />
                        <Label Text="Profile" FontSize="11" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </Grid>
    </Grid>

</ContentPage>
