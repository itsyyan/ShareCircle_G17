<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.TermsOfServicePage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="80" Padding="16,10,16,0" ColumnSpacing="12" VerticalOptions="Start">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5B2EFF" Offset="0.0" />
                    <GradientStop Color="#7C5CFF" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Frame
                Grid.Column="0"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                Padding="0"
                HasShadow="False"
                BackgroundColor="#B3FFFFFF"
                VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Label
                        Text="&#x2039;"
                        FontSize="24"
                        TextColor="#5B2EFF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-5,0,0" />
                </Grid>
            </Frame>

            <!-- Title -->
            <Label
                Grid.Column="1"
                Text="Terms of Service"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="2"
                Padding="0"
                HasShadow="False"
                BackgroundColor="Transparent"
                VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- Last Updated -->
                <Label
                    Text="Last Updated: December 2025"
                    FontSize="12"
                    TextColor="#6B7280"
                    HorizontalOptions="End" />

                <!-- Introduction -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Welcome to ShareCircle"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="By using ShareCircle, you agree to these Terms of Service. ShareCircle is a community platform that connects people who want to donate items (food and goods) with those who need them. Please read these terms carefully before using our service."
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.5" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Account Terms -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="1. Account Registration"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; You must provide accurate information when creating an account&#x000A;&#x2022; You are responsible for maintaining the security of your account&#x000A;&#x2022; You must be at least 13 years old to use ShareCircle&#x000A;&#x2022; One person may only have one account&#x000A;&#x2022; You are responsible for all activities under your account"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Donation Guidelines -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="2. Donation Guidelines"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />

                        <Label
                            Text="Acceptable Donations:"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#16A34A" />
                        <Label
                            Text="&#x2022; Food items: Fresh fruits, bread, packaged foods (within expiry date)&#x000A;&#x2022; Items: Clean clothes, toys in good condition, books"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />

                        <Label
                            Text="Prohibited Items:"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#DC2626"
                            Margin="0,8,0,0" />
                        <Label
                            Text="&#x2022; Expired or spoiled food&#x000A;&#x2022; Damaged or unsafe items&#x000A;&#x2022; Illegal items or substances&#x000A;&#x2022; Weapons or dangerous materials&#x000A;&#x2022; Items that violate intellectual property rights&#x000A;&#x2022; Personal hygiene items (used)&#x000A;&#x2022; Recalled products"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- User Conduct -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="3. User Conduct"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="You agree to:"
                            FontSize="14"
                            TextColor="#374151" />
                        <Label
                            Text="&#x2022; Treat all users with respect and courtesy&#x000A;&#x2022; Provide accurate descriptions and photos for donations&#x000A;&#x2022; Honor your donation commitments&#x000A;&#x2022; Respond to requests in a timely manner&#x000A;&#x2022; Meet at safe, public locations for item exchanges&#x000A;&#x2022; Not use the platform for commercial purposes&#x000A;&#x2022; Not harass, threaten, or abuse other users&#x000A;&#x2022; Not post false, misleading, or spam content"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Donation Requests -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="4. Donation Requests"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; Donors have full discretion to approve or reject requests&#x000A;&#x2022; Requesters should only request items they genuinely need&#x000A;&#x2022; Both parties should communicate clearly about pickup arrangements&#x000A;&#x2022; Donors may mark items as Reserved or Completed&#x000A;&#x2022; Requesters may cancel pending requests"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Location Services -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="5. Location Services"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; Location data is used to show nearby donations on the Explore Map&#x000A;&#x2022; You can save multiple addresses for convenience&#x000A;&#x2022; Drop-off locations are visible to users viewing your donation&#x000A;&#x2022; We recommend using public locations for safety"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Intellectual Property -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="6. Content &amp; Intellectual Property"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; You retain ownership of content you post (photos, descriptions)&#x000A;&#x2022; By posting, you grant ShareCircle license to display your content&#x000A;&#x2022; You must only upload photos you have the right to use&#x000A;&#x2022; ShareCircle branding and design are our intellectual property"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Liability -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="7. Limitation of Liability"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; ShareCircle is a platform connecting donors and recipients&#x000A;&#x2022; We do not inspect or verify donated items&#x000A;&#x2022; We are not responsible for the quality or safety of donated items&#x000A;&#x2022; Users exchange items at their own risk&#x000A;&#x2022; We are not liable for any disputes between users&#x000A;&#x2022; We recommend inspecting items before accepting"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Termination -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="8. Account Termination"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="&#x2022; You may delete your account at any time&#x000A;&#x2022; We may suspend or terminate accounts that violate these terms&#x000A;&#x2022; Violations include posting prohibited items, harassment, or fraud&#x000A;&#x2022; Upon termination, your donations will be removed"
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.6" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Changes -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="9. Changes to Terms"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="We may modify these Terms of Service at any time. Continued use of ShareCircle after changes constitutes acceptance of the new terms. We will notify users of significant changes through the app."
                            FontSize="14"
                            TextColor="#374151"
                            LineHeight="1.5" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Contact -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="16" BorderColor="#E5E7EB" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="10. Contact Us"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#5B2EFF" />
                        <Label
                            Text="If you have questions about these Terms of Service, please contact us at:"
                            FontSize="14"
                            TextColor="#374151" />
                        <Label
                            Text="Email: sharecircleapp@gmail.com"
                            FontSize="14"
                            TextColor="#5B2EFF"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
