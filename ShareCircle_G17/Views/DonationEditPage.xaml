<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:ShareCircle_G17.ViewModels"
    x:Class="ShareCircle_G17.Views.DonationEditPage" 
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="Transparent">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B2EFF" Offset="0.0" />
            <GradientStop Color="#EDE7FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="40,20,40,40" Spacing="20">

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <ImageButton Source="back2.png"
                             BackgroundColor="Transparent"
                             Command="{Binding BackCommand}"    
                             WidthRequest="12"
                             HeightRequest="12" 
                             Aspect="AspectFit" />

                <Label Text="Edit Post" 
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Upload Photo"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="#33FFFFFF"
                   CornerRadius="12"
                   Padding="12"
                   HeightRequest="180"
                   HasShadow="False"
                   HorizontalOptions="Fill">
                <Grid>
                    <Image Source="{Binding SelectedImageSource}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           IsVisible="{Binding IsImageVisible}" />

                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                                         IsVisible="{Binding ShowPlaceHolder}">
                        <Label Text="📷" FontSize="36" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="Tap to change photo"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UploadPhotoCommand}" NumberOfTapsRequired="1" />
                </Frame.GestureRecognizers>
            </Frame>

            <Label Text="What is it ?"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="White"
                   CornerRadius="50"
                   Padding="30,6,30,6"
                   HasShadow="False"
                   HorizontalOptions="Fill">
                <Entry Text="{Binding Title}"
                       Placeholder="Describe the item"
                       BackgroundColor="Transparent"
                       TextColor="Gray" />
            </Frame>

            <Label Text="Category"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" >

                <Frame BackgroundColor="{Binding FoodButtonColor}"
                       CornerRadius="32"
                       Padding="10"
                       HeightRequest="48"
                       WidthRequest="160"
                       HasShadow="False"
                       HorizontalOptions="Fill"
                       x:Name="FoodButton">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                        <Image Source="fruit.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Text="Food" FontSize="14" TextColor="{Binding FoodTextColor}" VerticalOptions="Center" x:Name="FoodButtonLabel" />
                    </HorizontalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectFoodCommand}" NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="{Binding ItemButtonColor}"
                       CornerRadius="32"
                       Padding="10"
                       HeightRequest="48"
                       WidthRequest="160"
                       HasShadow="False"
                       HorizontalOptions="Fill"
                       x:Name="ItemButton">
                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center" HorizontalOptions="Center">
                        <Image Source="apparel.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Text="Item" FontSize="14" TextColor="{Binding ItemTextColor}" VerticalOptions="Center" x:Name="ItemButtonLabel" />
                    </HorizontalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectItemCommand}" NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>
                </Frame>
            </HorizontalStackLayout>

            <Label Text="Item Description"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="White"
                   CornerRadius="22"
                   Padding="20"
                   HasShadow="False"
                   HorizontalOptions="Fill">
                <Editor Text="{Binding Description}"
                        Placeholder="Enter a item description..."
                        AutoSize="TextChanges"
                        HeightRequest="120"
                        BackgroundColor="Transparent"
                        TextColor="#222222" />
            </Frame>

            <Label Text="Contact Information (Email)"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="White"
                   CornerRadius="32"
                   Padding="30,6,30,6"
                   HasShadow="False"
                   HorizontalOptions="Fill">
                <Entry Text="{Binding ContactEmail}"
                       Placeholder="you@example.com"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       TextColor="#222222" />
            </Frame>

            <Label Text="Location / Item Drop-off"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="White"
                   CornerRadius="32"
                   Padding="30,6,30,6"
                   HasShadow="False"
                   HorizontalOptions="Fill">
                <Entry Text="{Binding Location}"
                       Placeholder="Enter drop-off location" 
                       BackgroundColor="Transparent"
                       TextColor="#222222" />
            </Frame>

            <Button Text="Save Changes"
                    FontSize="18"
                    BackgroundColor="#5B2EFF"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    Command="{Binding SaveChangesCommand}"
                    Margin="0, 10, 0, 0" />

            <Button Text="Delete Post"
                    FontSize="18"
                    BackgroundColor="#FF3366" 
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    Command="{Binding DeletePostCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>