<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.ForgotPasswordPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Transparent">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B2EFF" Offset="0.0" />
            <GradientStop Color="#EDE7FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="25" Padding="30,40,30,30" VerticalOptions="Start" HorizontalOptions="Center">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Image Source="lock.png" HeightRequest="70" WidthRequest="70" Aspect="AspectFit" Margin="0,0,0,10"/>
                    <Label Text="Forgot Password" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Label Text="Enter your email to receive a reset link" FontSize="16" TextColor="#E0E0E0" HorizontalTextAlignment="Center" Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <!-- Glassmorphic Card -->
                <Border
                    BackgroundColor="#30FFFFFF"
                    StrokeShape="RoundRectangle 25"
                    Stroke="#50FFFFFF"
                    StrokeThickness="1"
                    Padding="25,35"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    Margin="0,20">
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,10" Radius="20" Opacity="0.5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Email Field -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Email Address" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                                <Entry
                                    x:Name="EmailEntry"
                                    Placeholder="Enter your email"
                                    PlaceholderColor="#CCFFFFFF"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    HeightRequest="35"
                                    FontSize="14"
                                    Keyboard="Email" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Send Button -->
                        <Button
                            x:Name="SendButton"
                            Text="Send Reset Link"
                            TextColor="White"
                            BackgroundColor="#5B2EFF"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Fill"
                            Margin="0,10,0,0"
                            Clicked="OnSendClicked">
                            <Button.Shadow>
                                <Shadow Brush="#5B2EFF" Offset="0,4" Radius="8" Opacity="0.4"/>
                            </Button.Shadow>
                        </Button>

                        <!-- Activity Indicator -->
                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="White" />

                        <!-- Back to Login -->
                        <Button
                            Text="Back to Login"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="25"
                            HeightRequest="44"
                            HorizontalOptions="Fill"
                            Clicked="OnBackToLoginClicked"/>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
