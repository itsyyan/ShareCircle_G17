<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.SettingsPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="80" Padding="16,10,16,0" ColumnSpacing="12" VerticalOptions="Start">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5B2EFF" Offset="0.0" />
                    <GradientStop Color="#7C5CFF" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Frame
                Grid.Column="0"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                Padding="0"
                HasShadow="False"
                BackgroundColor="#B3FFFFFF"
                VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Label
                        Text="&#x2039;"
                        FontSize="24"
                        TextColor="#5B2EFF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-5,0,0" />
                </Grid>
            </Frame>

            <!-- Title -->
            <Label
                Grid.Column="1"
                Text="Settings"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="2"
                Padding="0"
                HasShadow="False"
                BackgroundColor="Transparent"
                VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="0,20,0,0">

            <!-- General Settings -->
            <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                <Label
                    Text="General"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="0">
                        <!-- Language -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="Language"
                                FontSize="16"
                                VerticalOptions="Center"
                                TextColor="#111827" />
                            <Label
                                Grid.Column="1"
                                Text="English"
                                FontSize="14"
                                TextColor="#6B7280"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                        <!-- Theme -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    Text="Dark Mode"
                                    FontSize="16"
                                    TextColor="#111827" />
                                <Label
                                    Text="Coming soon"
                                    FontSize="12"
                                    TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                x:Name="DarkModeSwitch"
                                OnColor="#5B2EFF"
                                IsToggled="False"
                                IsEnabled="False"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Privacy & Security -->
            <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                <Label
                    Text="Privacy &amp; Security"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="0">
                        <!-- Change Password -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="Change Password"
                                FontSize="16"
                                VerticalOptions="Center"
                                TextColor="#111827" />
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePasswordClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                        <!-- Privacy Policy -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="Privacy Policy"
                                FontSize="16"
                                VerticalOptions="Center"
                                TextColor="#111827" />
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                        <!-- Terms of Service -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="Terms of Service"
                                FontSize="16"
                                VerticalOptions="Center"
                                TextColor="#111827" />
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Data & Storage -->
            <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                <Label
                    Text="Data &amp; Storage"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="0">
                        <!-- Clear Cache -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    Text="Clear Cache"
                                    FontSize="16"
                                    TextColor="#111827" />
                                <Label
                                    Text="Free up storage space"
                                    FontSize="12"
                                    TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearCacheClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- About -->
            <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                <Label
                    Text="About"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#E5E7EB">
                    <VerticalStackLayout Spacing="0">
                        <!-- About ShareCircle -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="About ShareCircle"
                                FontSize="16"
                                VerticalOptions="Center"
                                TextColor="#111827" />
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#5B2EFF" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Danger Zone -->
            <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                <Label
                    Text="Danger Zone"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#E11D48" />

                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="0" BorderColor="#FEE2E2">
                    <VerticalStackLayout Spacing="0">
                        <!-- Delete Account -->
                        <Grid Padding="16" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    Text="Delete Account"
                                    FontSize="16"
                                    TextColor="#E11D48" />
                                <Label
                                    Text="Permanently delete your account"
                                    FontSize="12"
                                    TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text=">" FontSize="18" TextColor="#E11D48" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteAccountClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- App Version -->
            <VerticalStackLayout Spacing="6" Padding="20,10,20,30" HorizontalOptions="Center">
                <Label
                    x:Name="VersionLabel"
                    Text="Version 1.0.0"
                    FontSize="13"
                    TextColor="#9CA3AF"
                    HorizontalOptions="Center" />
                <Label
                    Text="© 2025 ShareCircle Team"
                    FontSize="11"
                    TextColor="#D1D5DB"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
