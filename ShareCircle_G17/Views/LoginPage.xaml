<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.LoginPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Transparent">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B2EFF" Offset="0.0" />
            <GradientStop Color="#EDE7FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="25" Padding="30,40,30,30" VerticalOptions="Start" HorizontalOptions="Center">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Image Source="lock.png" HeightRequest="70" WidthRequest="70" Aspect="AspectFit" Margin="0,0,0,10"/>
                    <Label Text="Welcome Back" FontSize="30" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Label Text="Sign in to continue" FontSize="16" TextColor="#E0E0E0" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Glassmorphic Login Card -->
                <Border
                    BackgroundColor="#30FFFFFF"
                    StrokeShape="RoundRectangle 25"
                    Stroke="#50FFFFFF"
                    StrokeThickness="1"
                    Padding="25,35"
                    WidthRequest="340"
                    HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,10" Radius="20" Opacity="0.5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        
                        <!-- Username Field -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Username or Email" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                                <Entry
                                    x:Name="UsernameEntry"
                                    Placeholder="Enter username or email"
                                    PlaceholderColor="#CCFFFFFF"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    HeightRequest="35"
                                    FontSize="14" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Password Field -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Password" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                                <Entry
                                    x:Name="PasswordEntry"
                                    Placeholder="Enter password"
                                    PlaceholderColor="#CCFFFFFF"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    IsPassword="True"
                                    HeightRequest="35"
                                    FontSize="14" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Options Row -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <CheckBox x:Name="RememberMeCheckBox" Color="White" VerticalOptions="Center"/>
                                <Label Text="Remember me" TextColor="#F0F0F0" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRememberMeLabelTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                            
                            <Label Grid.Column="1" 
                                   Text="Forgot Password?" 
                                   TextColor="white"
                                   FontSize="12" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgetPasswordClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Login Button -->
                        <Button Text="LOG IN"
                                TextColor="White"
                                BackgroundColor="#5B2EFF"
                                CornerRadius="25"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Margin="0,10,0,0"
                                Clicked="OnLoginClicked">
                            <Button.Shadow>
                                <Shadow Brush="#5B2EFF" Offset="0,4" Radius="8" Opacity="0.4"/>
                            </Button.Shadow>
                        </Button>

                        <!-- Divider -->
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,10">
                            <BoxView Grid.Column="0" HeightRequest="1" Color="#80FFFFFF" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="OR" TextColor="White" FontSize="12" Opacity="0.8"/>
                            <BoxView Grid.Column="2" HeightRequest="1" Color="#80FFFFFF" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Register Button -->
                        <Button Text="Create an Account"
                                BackgroundColor="#105B2EFF"
                                TextColor="#5B2EFF"
                                BorderColor="#5B2EFF"
                                BorderWidth="1"
                                CornerRadius="25"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Clicked="OnRegisterClicked"/>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>


