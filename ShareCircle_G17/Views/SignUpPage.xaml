<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.SignUpPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="Transparent"
    Padding="0">

    <!-- Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B2EFF" Offset="0.0" />
            <GradientStop Color="#EDE7FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="40,30,40,30"
            HorizontalOptions="Center"
            VerticalOptions="Start">

            <!-- Logo -->
            <Image
                Source="lock.png"
                HeightRequest="60"
                WidthRequest="90"
                HorizontalOptions="Center" />

            <!-- Title -->
            <Label
                Text="Sign Up"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="White" />

            <!-- Glassmorphic Card -->
            <Border
                BackgroundColor="#30FFFFFF"
                StrokeShape="RoundRectangle 25"
                Stroke="#50FFFFFF"
                StrokeThickness="1"
                Padding="25,35"
                WidthRequest="340"
                HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,10" Radius="20" Opacity="0.5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <!-- Username -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Username" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                            <Entry
                                x:Name="UsernameEntry"
                                Placeholder="Enter username"
                                PlaceholderColor="#CCFFFFFF"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                HeightRequest="35"
                                FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Email -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Email" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                            <Entry
                                x:Name="EmailEntry"
                                Placeholder="Enter email"
                                PlaceholderColor="#CCFFFFFF"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                HeightRequest="35"
                                FontSize="14"
                                Keyboard="Email" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Password -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Password" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Enter password"
                                IsPassword="True"
                                PlaceholderColor="#CCFFFFFF"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                HeightRequest="35"
                                FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Confirm Password -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Confirm Password" FontSize="11" TextColor="#F0F0F0" FontAttributes="Bold" Margin="0,5,0,0"/>
                            <Entry
                                x:Name="ConfirmPasswordEntry"
                                Placeholder="Confirm password"
                                IsPassword="True"
                                PlaceholderColor="#CCFFFFFF"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                HeightRequest="35"
                                FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Sign Up button -->
                    <Button
                        Text="Sign Up"
                        TextColor="White"
                        BackgroundColor="#5B2EFF"
                        CornerRadius="20"
                        HeightRequest="44"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,0"
                        Clicked="OnSignUpClicked">
                        <Button.Shadow>
                            <Shadow Brush="#5B2EFF" Offset="0,3" Radius="6" Opacity="0.35"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,5">
                        <BoxView Grid.Column="0" HeightRequest="1" Color="#80FFFFFF" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="OR" TextColor="White" FontSize="11" Opacity="0.7"/>
                        <BoxView Grid.Column="2" HeightRequest="1" Color="#80FFFFFF" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Sign In link -->
                    <Label
                        HorizontalOptions="Center"
                        Margin="0,5,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Already have an account? " TextColor="#5B2EFF" FontSize="13" />
                                <Span Text="Sign In" TextColor="White" FontSize="13" FontAttributes="Bold" TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSignInClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

