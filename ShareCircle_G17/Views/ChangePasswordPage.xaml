<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.ChangePasswordPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" HeightRequest="80" Padding="16,10,16,0" ColumnSpacing="12" VerticalOptions="Start">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5B2EFF" Offset="0.0" />
                    <GradientStop Color="#7C5CFF" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Frame
                Grid.Column="0"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                Padding="0"
                HasShadow="False"
                BackgroundColor="#B3FFFFFF"
                VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Frame.GestureRecognizers>
                <Grid>
                    <Label
                        Text="&#x2039;"
                        FontSize="24"
                        TextColor="#5B2EFF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-5,0,0" />
                </Grid>
            </Frame>

            <!-- Title -->
            <Label
                Grid.Column="1"
                Text="Change Password"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="2"
                Padding="0"
                HasShadow="False"
                BackgroundColor="Transparent"
                VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="0,20,0,0">
                <VerticalStackLayout Padding="20,0,20,0" Spacing="6">
                    <Label
                        Text="Secure your account with a new password"
                        FontSize="14"
                        TextColor="#6B7280" />
                </VerticalStackLayout>

                <!-- Verification Section -->
                <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                    <Label
                        Text="Verify Your Identity"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="20" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="16">
                            <Label
                                x:Name="UserEmailLabel"
                                Text="Email: loading..."
                                FontSize="14"
                                TextColor="#6B7280" />

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Enter your current password"
                                    FontSize="14"
                                    TextColor="#111827" />
                                <Entry
                                    x:Name="CurrentPasswordEntry"
                                    Placeholder="Current password"
                                    IsPassword="True"
                                    BackgroundColor="#F9FAFB"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- New Password Section -->
                <VerticalStackLayout Spacing="10" Padding="20,0,20,0">
                    <Label
                        Text="New Password"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="20" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="New password"
                                    FontSize="14"
                                    TextColor="#111827" />
                                <Entry
                                    x:Name="NewPasswordEntry"
                                    Placeholder="Enter new password"
                                    IsPassword="True"
                                    BackgroundColor="#F9FAFB"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF" />
                                <Label
                                    Text="Must be at least 6 characters"
                                    FontSize="12"
                                    TextColor="#9CA3AF" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Confirm new password"
                                    FontSize="14"
                                    TextColor="#111827" />
                                <Entry
                                    x:Name="ConfirmPasswordEntry"
                                    Placeholder="Re-enter new password"
                                    IsPassword="True"
                                    BackgroundColor="#F9FAFB"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF" />
                            </VerticalStackLayout>

                            <!-- Password Requirements -->
                            <Frame BackgroundColor="#F0F9FF" CornerRadius="8" HasShadow="False" Padding="12" BorderColor="#BFDBFE">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="Password Requirements:"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#1E40AF" />
                                    <Label
                                        Text="- At least 6 characters"
                                        FontSize="11"
                                        TextColor="#3B82F6" />
                                    <Label
                                        Text="- Contains letters and numbers (recommended)"
                                        FontSize="11"
                                        TextColor="#3B82F6" />
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Change Password Button -->
                <Grid Padding="20,10,20,30">
                    <Button
                        x:Name="ChangePasswordButton"
                        Text="Change Password"
                        BackgroundColor="#5B2EFF"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnChangePasswordClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
