<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShareCircle_G17.Views.DonationPage"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header (fixed) -->
        <Grid
            Grid.Row="0"
            HeightRequest="64"
            Padding="12,16"
            ColumnSpacing="10"
            BackgroundColor="#5B2EFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <ImageButton
                Grid.Column="0"
                WidthRequest="36"
                HeightRequest="36"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource
                        FontFamily="Arial"
                        Glyph="&lt;"
                        Size="20"
                        Color="White" />
                </ImageButton.Source>
            </ImageButton>

            <!-- Title -->
            <Label
                Grid.Column="1"
                x:Name="PageTitleLabel"
                Text="Create Post"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                Margin="6,0,0,0" />
        </Grid>

        <!-- Main content -->
        <ScrollView x:Name="DonationScrollView"
                    Grid.Row="1"
                    BackgroundColor="#F9FAFB">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Section 1: Photos (Moved to top for better flow) -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Item Photos"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#111827" />
                        
                        <!-- Upload Area -->
                        <Border
                            BackgroundColor="#F9FAFB"
                            Stroke="#E5E7EB"
                            StrokeThickness="2"
                            StrokeDashArray="6,4"
                            StrokeShape="RoundRectangle 12"
                            Padding="0"
                            HorizontalOptions="Fill"
                            HeightRequest="130">
                            <Grid>
                                <!-- Placeholder -->
                                <VerticalStackLayout
                                    x:Name="UploadPlaceholder"
                                    Spacing="8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Image
                                        Source="https://img.icons8.com/fluency/48/camera.png"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="Tap to upload photos"
                                        FontSize="13"
                                        TextColor="#6B7280"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Thumbnails -->
                                <CollectionView
                                    x:Name="UploadPreviewGrid"
                                    ItemsSource="{Binding SelectedImages}"
                                    ItemsLayout="HorizontalList"
                                    SelectionMode="None"
                                    HorizontalScrollBarVisibility="Never"
                                    Margin="8">
                                    <CollectionView.Triggers>
                                        <DataTrigger TargetType="CollectionView"
                                                     Binding="{Binding SelectedImages.Count}"
                                                     Value="0">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </CollectionView.Triggers>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Margin="0,0,8,0" HeightRequest="100" WidthRequest="100">
                                                <Grid>
                                                    <Image Source="{Binding .}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                                    <Grid BackgroundColor="#20000000">
                                                        <Frame.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnPreviewImageTapped" CommandParameter="{Binding .}" />
                                                        </Frame.GestureRecognizers>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- Count Badge -->
                                <Border
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="10"
                                    BackgroundColor="#CCFFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4">
                                    <Label
                                        x:Name="PhotoCountLabel"
                                        Text="0/10"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#5B2EFF" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUploadPhotoTapped" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 2: Details -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <!-- Product Name -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="What are you giving?" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                            <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F9FAFB" Padding="12,2">
                                <Entry
                                    x:Name="WhatIsItEntry"
                                    Placeholder="e.g., Homemade Cookies"
                                    BackgroundColor="Transparent"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Description" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                            <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F9FAFB" Padding="12,10">
                                <Editor
                                    x:Name="DescriptionEditor"
                                    Placeholder="Describe the item, condition, quantity..."
                                    AutoSize="TextChanges"
                                    HeightRequest="100"
                                    BackgroundColor="Transparent"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 3: Category -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Category" FontSize="16" FontAttributes="Bold" TextColor="#111827" />

                        <!-- Toggle -->
                        <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="4" BackgroundColor="#F9FAFB">
                            <Grid ColumnDefinitions="*,*">
                                <Button x:Name="FoodToggle"
                                        Grid.Column="0"
                                        Text="Food"
                                        Clicked="OnFoodToggleClicked"
                                        BackgroundColor="#5B2EFF"
                                        TextColor="White"
                                        CornerRadius="20"
                                        HeightRequest="40"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Margin="0"
                                        BorderWidth="0" />
                                <Button x:Name="ItemToggle"
                                        Grid.Column="1"
                                        Text="Items"
                                        Clicked="OnItemToggleClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="#6B7280"
                                        CornerRadius="20"
                                        HeightRequest="40"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Margin="0"
                                        BorderWidth="0" />
                            </Grid>
                        </Border>

                        <!-- Food subcategories -->
                        <VerticalStackLayout x:Name="FoodSubLayout" Spacing="10" IsVisible="True">
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" AlignContent="Start">
                                <Button x:Name="FruitsVegButton" Text="Fruits &amp; Veg" ImageSource="https://img.icons8.com/color/48/salad.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="fruit" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="BakeryButton" Text="Bakery" ImageSource="https://img.icons8.com/color/48/bread.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="bread" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="PackagedButton" Text="Packaged" ImageSource="https://img.icons8.com/color/48/ingredients.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="packaged" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="CookedButton" Text="Cooked" ImageSource="https://img.icons8.com/color/48/cooking-pot.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="cooked" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="HalalButton" Text="Halal" ImageSource="https://img.icons8.com/color/48/mosque.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="halal" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="FoodOthersButton" Text="Others" ImageSource="https://img.icons8.com/color/48/more.png" ContentLayout="Left,8" Clicked="OnFoodSubcategoryClicked" CommandParameter="others" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Item subcategories -->
                        <VerticalStackLayout x:Name="ItemSubLayout" Spacing="10" IsVisible="False">
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" AlignContent="Start">
                                <Button x:Name="ClothesButton" Text="Clothes" ImageSource="https://img.icons8.com/color/48/t-shirt.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="cloths" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="BooksButton" Text="Books" ImageSource="https://img.icons8.com/color/48/books.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="books" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="FurnitureButton" Text="Furniture" ImageSource="https://img.icons8.com/color/48/armchair.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="furniture" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="ElectronicsButton" Text="Electronics" ImageSource="https://img.icons8.com/color/48/laptop.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="electronics" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="ToysButton" Text="Toys" ImageSource="https://img.icons8.com/color/48/teddy-bear.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="toys-household" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                                <Button x:Name="ItemOthersButton" Text="Others" ImageSource="https://img.icons8.com/color/48/more.png" ContentLayout="Left,8" Clicked="OnItemSubcategoryClicked" CommandParameter="others" BackgroundColor="#F3F4F6" TextColor="#111827" CornerRadius="12" Padding="12,0" HeightRequest="38" FontSize="13" Margin="0,0,8,8" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 4: Address -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pickup Location" FontSize="16" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Text="Add New"
                                FontSize="12"
                                HeightRequest="32"
                                CornerRadius="16"
                                Padding="12,0"
                                BackgroundColor="#EEF2FF"
                                TextColor="#5B2EFF"
                                Clicked="OnAddAddressClicked" />
                        </Grid>

                        <CollectionView
                            x:Name="AddressesCollectionView"
                            SelectionMode="Single"
                            ItemsSource="{Binding Addresses}"
                            SelectionChanged="OnAddressSelectionChanged"
                            HeightRequest="180">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="White"
                                        Padding="14">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="#E5E7EB" />
                                                        <Setter Property="BackgroundColor" Value="White" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="#5B2EFF" />
                                                        <Setter Property="BackgroundColor" Value="#F5F3FF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                            <!-- Accent bar -->
                                            <BoxView Grid.RowSpan="3" Grid.Column="0" WidthRequest="4" CornerRadius="2" Color="#5B2EFF" VerticalOptions="Fill" />

                                            <!-- Name + Default Tag -->
                                            <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold" TextColor="#111827" />
                                                <Frame IsVisible="{Binding IsDefault}"
                                                       Padding="8,4"
                                                       BackgroundColor="#EDE9FE"
                                                       CornerRadius="10"
                                                       HasShadow="False"
                                                       BorderColor="#DDD6FE">
                                                    <Label Text="Default" FontSize="10" TextColor="#4F46E5" />
                                                </Frame>
                                            </HorizontalStackLayout>

                                            <!-- Phone -->
                                            <Label
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                Text="{Binding PhoneNumber}"
                                                FontSize="12"
                                                TextColor="#6B7280" />

                                            <!-- Address -->
                                            <Label
                                                Grid.Column="1"
                                                Grid.Row="2"
                                                Text="{Binding OneLine}"
                                                FontSize="12"
                                                TextColor="#4B5563"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />

                                            <!-- Edit Button -->
                                            <ImageButton
                                                Grid.Column="2"
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                BackgroundColor="#F3F4F6"
                                                CornerRadius="16"
                                                Padding="6"
                                                VerticalOptions="Center"
                                                CommandParameter="{Binding AddressId}"
                                                Clicked="OnEditAddressClicked">
                                                <ImageButton.Source>
                                                    <FontImageSource
                                                        FontFamily="Arial"
                                                        Glyph="&#x270E;"
                                                        Size="14"
                                                        Color="#5B2EFF" />
                                                </ImageButton.Source>
                                            </ImageButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed bottom action -->
        <Grid Grid.Row="2" Padding="20,16,20,24" BackgroundColor="White">
            <Grid.Shadow>
                <Shadow Brush="#10000000" Offset="0,-4" Radius="10" Opacity="0.2"/>
            </Grid.Shadow>
            <Button
                x:Name="PostButton"
                Text="Post Donation"
                FontSize="16"
                FontAttributes="Bold"
                BackgroundColor="#5B2EFF"
                TextColor="White"
                CornerRadius="25"
                HeightRequest="50"
                HorizontalOptions="Fill"
                Clicked="OnPostDonationClicked">
                <Button.Shadow>
                    <Shadow Brush="#5B2EFF" Offset="0,4" Radius="8" Opacity="0.4"/>
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- Custom photo options overlay -->
        <Grid x:Name="PhotoOptionsOverlay"
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPhotoOptionsBackdropTapped" />
            </Grid.GestureRecognizers>
            <Grid VerticalOptions="End" Padding="20,20,20,32">
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Add Photo" FontSize="18" FontAttributes="Bold" TextColor="#111827" HorizontalOptions="Center"/>
                        <Button Text="Take Photo"
                                BackgroundColor="#5B2EFF"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Clicked="OnTakePhotoClicked" />
                        <Button Text="Choose from Gallery"
                                BackgroundColor="#F3F4F6"
                                TextColor="#111827"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Clicked="OnChooseGalleryClicked" />
                        <Button Text="Cancel"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                HeightRequest="40"
                                Clicked="OnCancelPhotoOptionsClicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- Image preview overlay -->
        <Grid x:Name="ImagePreviewOverlay"
              Grid.RowSpan="3"
              BackgroundColor="Black"
              IsVisible="False"
              InputTransparent="False">
            <Grid RowDefinitions="Auto,*">
                <Button Grid.Row="0"
                        Text="Close"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End"
                        Margin="0,20,20,0"
                        Clicked="OnCloseImagePreviewTapped"/>
                <CarouselView x:Name="PreviewCarousel"
                              Grid.Row="1"
                              ItemsSource="{Binding SelectedImages}"
                              Loop="False">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding .}" Aspect="AspectFit" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
