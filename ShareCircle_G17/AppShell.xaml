<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShareCircle_G17.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShareCircle_G17.Views"
    xmlns:local="clr-namespace:ShareCircle_G17"
    Shell.NavBarIsVisible="False"
    Title="ShareCircle_G17">

    <!-- Start with SplashPage -->
    <ShellContent
        ContentTemplate="{DataTemplate local:SplashPage}"
        Route="SplashPage" />

    <!-- LoginPage as root content -->
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- HomePage as root content -->
    <ShellContent
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <!-- Notifications -->
    <ShellContent
        ContentTemplate="{DataTemplate views:NotificationsSettingsPage}"
        Route="NotificationsSettingsPage" />

    <!-- Other pages are registered as routes in AppShell.xaml.cs -->

</Shell>
