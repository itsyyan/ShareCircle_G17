<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - ShareCircle Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/open-iconic@1.1.1/font/css/open-iconic-bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <div class="page">
        <div class="sidebar">
            <%- include('partials/navbar') %>
        </div>
        <main>
            <div class="top-row px-4">
            </div>
            <article class="content px-4">
                <h1>Admin Dashboard</h1>
                <p>Welcome to ShareCircle Admin Panel.</p>

                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-white bg-primary mb-3">
                            <div class="card-header">Total App Users</div>
                            <div class="card-body">
                                <h2 class="card-title"><%= totalUsers %></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-success mb-3">
                            <div class="card-header">Total Posts</div>
                            <div class="card-body">
                                <h2 class="card-title"><%= totalPosts %></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-info mb-3">
                            <div class="card-header">New Users (This Month)</div>
                            <div class="card-body">
                                <h2 class="card-title"><%= newUsers %></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <h3>Top 5 Donors of the Month</h3>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Username</th>
                            <th>Donations (Total)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% topDonors.forEach((donor, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= donor.name %></td>
                            <td><%= donor.count %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </article>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
