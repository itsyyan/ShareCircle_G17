<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - ShareCircle Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/open-iconic@1.1.1/font/css/open-iconic-bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <div class="page">
        <div class="sidebar">
            <%- include('partials/navbar') %>
        </div>
        <main>
            <div class="top-row px-4">
            </div>
            <article class="content px-4">
                <h3>Manage Posts</h3>
                <div class="mb-3">
                    <a href="/posts?refresh=true" class="btn btn-outline-primary btn-sm">
                        Refresh List
                    </a>
                </div>

                <% if (message) { %>
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <%= message %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
                <% } %>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>User</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% posts.forEach(post => { %>
                        <tr>
                            <td>
                                <% if (post.ImageUrl) { %>
                                <img src="<%= post.ImageUrl %>" width="50" height="50" style="object-fit:cover; border-radius: 8px;" alt="Post image">
                                <% } %>
                            </td>
                            <td><%= post.Title || 'N/A' %></td>
                            <td><%= post.Username || 'N/A' %></td>
                            <td><%= post.Category || 'N/A' %></td>
                            <td>
                                <%
                                    let badgeClass = 'bg-primary';
                                    if (post.Status === 'Available') badgeClass = 'bg-success';
                                    else if (post.Status === 'Reserved') badgeClass = 'bg-warning';
                                    else if (post.Status === 'Completed') badgeClass = 'bg-secondary';
                                %>
                                <span class="badge <%= badgeClass %>"><%= post.Status || 'Unknown' %></span>
                            </td>
                            <td><%= post.CreatedAt ? new Date(post.CreatedAt).toLocaleDateString() : 'N/A' %></td>
                            <td>
                                <form action="/posts/delete/<%= post.postId %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </article>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
